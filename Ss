#target indesign

(function () {
    if (app.documents.length === 0) {
        alert("Open the final print file first.");
        return;
    }
    var doc = app.activeDocument;

    var baseFolder;
    try { baseFolder = doc.filePath; } catch (e) {
        baseFolder = Folder.selectDialog("Choose where to create the 'pages' folder");
        if (!baseFolder) return;
    }
    var out = new Folder(baseFolder.fsName + "/pages");
    if (!out.exists) out.create();

    var total = doc.pages.length;
    if (!confirm("Export " + total + " pages as images to:\n" + out.fsName + "\n\nContinue?")) return;

    var p = app.jpegExportPreferences;
    p.jpegExportRange = ExportRangeOrAllPages.EXPORT_RANGE;
    p.exportResolution = 96;
    p.jpegQuality = JPEGOptionsQuality.MEDIUM;
    p.jpegColorSpace = JpegColorSpaceEnum.RGB;
    p.antiAlias = true;
    p.exportingSpread = false;
    try { p.useDocumentBleeds = false; } catch (e) {}
    try { p.simulateOverprint = true; } catch (e) {}

    function pad(n) { var s = String(n); while (s.length < 3) s = "0" + s; return s; }

    var failed = [];
    for (var i = 0; i < total; i++) {
        p.pageString = "+" + (i + 1);
        var f = new File(out.fsName + "/page-" + pad(i + 1) + ".jpg");
        try {
            doc.exportFile(ExportFormat.JPG, f, false);
        } catch (e) {
            failed.push(i + 1);
        }
    }

    alert("Done!\n" + (total - failed.length) + " images saved in:\n" + out.fsName +
          (failed.length ? "\n\nFailed pages: " + failed.join(", ") : ""));
    out.execute();
})();
