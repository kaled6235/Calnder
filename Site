#target indesign

// ======== SETTINGS ========
var FIX_BLEED = true;   // set to false if you don't want the bleed changed
// ==========================

(function () {
    var REPORT = [];
    function log(s) { REPORT.push(s); }
    function list(title, arr, max) {
        if (!arr.length) return;
        max = max || 25;
        log("  " + title + " (" + arr.length + "):");
        for (var i = 0; i < Math.min(arr.length, max); i++) log("     - " + arr[i]);
        if (arr.length > max) log("     ... and " + (arr.length - max) + " more");
    }

    var SPEC = [
        { label: "Print-Ready Interior (imposed order) - PRINT", role: "print" },
        { label: "Cover - PRINT", role: "print" },
        { label: "Interior Pages (natural order) - PREVIEW", role: "preview" }
    ];

    var outFolder = Folder.selectDialog("Choose a folder for the final files");
    if (!outFolder) return;

    var files = [];
    for (var s = 0; s < SPEC.length; s++) {
        files.push(File.openDialog("Select the InDesign file for:\n" + SPEC[s].label + "\n(Cancel to skip)"));
    }

    var summary = [], chinaFound = [];
    app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT;
    try {
        for (var k = 0; k < SPEC.length; k++) {
            if (!files[k]) { log("\n===== " + SPEC[k].label + " =====\n  SKIPPED"); continue; }
            try {
                summary.push(processFile(files[k], SPEC[k]));
            } catch (e) {
                log("  ERROR: " + e + " (line " + e.line + ")");
                summary.push(SPEC[k].label + ": ERROR, see report");
            }
        }
    } finally {
        app.scriptPreferences.userInteractionLevel = UserInteractionLevels.INTERACT_WITH_ALL;
    }

    log("\n==================================================");
    log("\"Printed in China\": " + (chinaFound.length ? "found in " + chinaFound.join(", ") : "NOT FOUND in any file - please add it"));

    var rf = new File(outFolder.fsName + "/Preflight_Report.txt");
    rf.encoding = "UTF-8";
    rf.open("w");
    rf.write("PRINTNINJA PREFLIGHT REPORT\n" + new Date() + "\n" + REPORT.join("\n"));
    rf.close();
    alert("Finished!\n\n" + summary.join("\n") +
          "\n\nPrinted in China: " + (chinaFound.length ? "found" : "NOT FOUND") +
          "\n\nFull report: Preflight_Report.txt");
    rf.execute();

    // ==========================================================
    function processFile(file, spec) {
        var doc = app.open(file, true);
        var base = file.name.replace(/\.indd$/i, "");
        var attention = 0;
        log("\n==================================================");
        log(spec.label);
        log("File: " + file.name);
        log("==================================================");

        var vp = doc.viewPreferences;
        vp.horizontalMeasurementUnits = MeasurementUnits.POINTS;
        vp.verticalMeasurementUnits = MeasurementUnits.POINTS;

        // ---- Page count (check)
        var pc = doc.pages.length;
        log("[Pages] " + pc + (pc % 2 ? "  <-- WARNING: odd page count" : ""));
        if (pc % 2) attention++;

        // ---- Links (check only)
        var missing = [], modified = [];
        for (var i = 0; i < doc.links.length; i++) {
            var L = doc.links[i];
            if (L.status == LinkStatus.LINK_MISSING || L.status == LinkStatus.LINK_INACCESSIBLE) missing.push(L.name);
            else if (L.status == LinkStatus.LINK_OUT_OF_DATE) modified.push(L.name);
        }
        log("[Links] missing: " + missing.length + ", modified (not updated): " + modified.length);
        list("MISSING LINKS", missing);
        list("MODIFIED LINKS - update them in the Links panel", modified);
        attention += (missing.length ? 1 : 0) + (modified.length ? 1 : 0);

        // ---- Fonts (check)
        var badFonts = [];
        for (i = 0; i < doc.fonts.length; i++) {
            try { if (doc.fonts[i].status != FontStatus.INSTALLED) badFonts.push(doc.fonts[i].name); } catch (e) {}
        }
        log("[Fonts] missing: " + badFonts.length);
        list("MISSING FONTS", badFonts);
        attention += badFonts.length ? 1 : 0;

        // ---- Text colors (FIX) + overset (check)
        var blackSw = doc.swatches.itemByName("Black");
        var fixedBlack = 0, fixedReg = 0, overset = [];
        var stories = doc.stories;
        for (var st = 0; st < stories.length; st++) {
            var story = stories[st];
            var ranges = story.textStyleRanges.everyItem().getElements();
            for (var t = 0; t < ranges.length; t++) {
                var r = ranges[t], fc;
                try { fc = r.fillColor; } catch (e) { continue; }
                if (!fc || !fc.isValid) continue;
                var nm = ""; try { nm = fc.name; } catch (e) {}
                if (nm == "Registration") { r.fillColor = blackSw; fixedReg++; continue; }
                if (fc.constructor.name != "Color" || nm == "Black") continue;
                try {
                    var v = fc.colorValue;
                    if (fc.space == ColorSpace.CMYK && v[3] >= 85 && (v[0] + v[1] + v[2]) > 0 && r.pointSize < 9) {
                        r.fillColor = blackSw; fixedBlack++;
                    } else if (fc.space == ColorSpace.RGB && v[0] < 40 && v[1] < 40 && v[2] < 40) {
                        r.fillColor = blackSw; fixedBlack++;
                    }
                } catch (e) {}
            }
            try {
                if (story.overflows) {
                    var tc = story.textContainers, last = tc[tc.length - 1];
                    overset.push("page " + (last.parentPage ? last.parentPage.name : "pasteboard"));
                }
            } catch (e) {}
        }
        log("[Text color] rich/RGB black -> 100% K: FIXED " + fixedBlack + " ranges; Registration -> Black: FIXED " + fixedReg);
        list("OVERSET TEXT", overset);
        attention += overset.length ? 1 : 0;

        // ---- Swatches -> CMYK process (FIX)
        var conv = 0, spot = 0;
        for (i = doc.colors.length - 1; i >= 0; i--) {
            var c = doc.colors[i];
            try {
                if (!c.name || c.name.charAt(0) == "[" || c.name == "Registration" || c.name == "Paper" || c.name == "Black" || c.name == "None") continue;
                if (c.model == ColorModel.SPOT) { c.model = ColorModel.PROCESS; spot++; }
                if (c.space != ColorSpace.CMYK) { c.space = ColorSpace.CMYK; conv++; }
            } catch (e) {}
        }
        try { doc.transparencyPreferences.blendingSpace = BlendingSpace.CMYK; } catch (e) {}
        log("[Swatches] RGB/LAB -> CMYK: FIXED " + conv + ", spot -> process: FIXED " + spot);
        try { log("[Document CMYK profile] " + doc.cmykProfile); } catch (e) {}

        // ---- Bleed (FIX if enabled)
        var dp = doc.documentPreferences, NEED = 9; // 0.125 in = 9 pt
        var bl = [dp.documentBleedTopOffset, dp.documentBleedBottomOffset, dp.documentBleedInsideOrLeftOffset, dp.documentBleedOutsideOrRightOffset];
        var bleedOK = true;
        for (i = 0; i < 4; i++) if (bl[i] < NEED - 0.01) bleedOK = false;
        if (bleedOK) {
            log("[Bleed] OK (0.125 in or more)");
        } else if (spec.role == "print" && FIX_BLEED) {
            dp.documentBleedUniformSize = true;
            dp.documentBleedTopOffset = NEED;
            dp.documentBleedBottomOffset = NEED;
            dp.documentBleedInsideOrLeftOffset = NEED;
            dp.documentBleedOutsideOrRightOffset = NEED;
            log("[Bleed] was under 0.125 in -> FIXED to 0.125 in (artwork must still extend into it)");
        } else {
            log("[Bleed] under 0.125 in" + (spec.role == "print" ? "  <-- WARNING" : " (preview, ignored)"));
            if (spec.role == "print") attention++;
        }

        // ---- Artwork reaching bleed + text safe area (check)
        var noBleed = [], unsafe = [];
        for (var p = 0; p < doc.pages.length; p++) {
            var pg = doc.pages[p], pb = pg.bounds;
            var items = pg.pageItems.everyItem().getElements();
            for (var j = 0; j < items.length; j++) {
                var it = items[j], vb;
                try { vb = it.visibleBounds; } catch (e) { continue; }
                var type = it.constructor.name;
                if (type == "TextFrame") {
                    var hasText = false; try { hasText = it.contents.length > 0; } catch (e) {}
                    if (hasText && (vb[0] - pb[0] < NEED || vb[1] - pb[1] < NEED || pb[2] - vb[2] < NEED || pb[3] - vb[3] < NEED)) {
                        unsafe.push("page " + pg.name);
                    }
                } else if (type == "Rectangle" || type == "Polygon" || type == "Oval") {
                    var filled = false;
                    try { filled = it.graphics.length > 0 || (it.fillColor && it.fillColor.name != "None"); } catch (e) {}
                    if (!filled) continue;
                    var T = 0.5;
                    if (Math.abs(vb[0] - pb[0]) < T || Math.abs(vb[1] - pb[1]) < T || Math.abs(vb[2] - pb[2]) < T || Math.abs(vb[3] - pb[3]) < T) {
                        noBleed.push("page " + pg.name);
                    }
                }
            }
        }
        list("CHECK: artwork stops exactly at trim (no bleed)", uniq(noBleed));
        list("CHECK: text frames closer than 1/8 in to trim", uniq(unsafe));
        if (spec.role == "print") attention += (noBleed.length ? 1 : 0) + (unsafe.length ? 1 : 0);

        // ---- Images (check)
        var low = [], mid = [], rgb = 0, gr = doc.allGraphics;
        for (i = 0; i < gr.length; i++) {
            var g = gr[i], where = "pasteboard", nmL = "embedded";
            try { if (g.parentPage) where = g.parentPage.name; } catch (e) {}
            try { nmL = g.itemLink.name; } catch (e) {}
            try {
                var ppi = g.effectivePpi;
                if (ppi) {
                    var mn = Math.min(ppi[0], ppi[1]);
                    if (mn < 200) low.push("page " + where + ": " + nmL + " (" + Math.round(mn) + " ppi)");
                    else if (mn < 300) mid.push("page " + where + ": " + nmL + " (" + Math.round(mn) + " ppi)");
                }
            } catch (e) {}
            try { if (g.space == "RGB") rgb++; } catch (e) {}
        }
        log("[Images] total: " + gr.length + ", RGB (converted to CMYK on export only): " + rgb);
        list("LOW-RES IMAGES under 200 ppi - REPLACE", low);
        list("Images 200-299 ppi (acceptable)", mid);
        attention += low.length ? 1 : 0;

        // ---- "Printed in China" (check only)
        app.findTextPreferences = NothingEnum.NOTHING;
        app.findChangeTextOptions.caseSensitive = false;
        app.findTextPreferences.findWhat = "Printed in China";
        var hits = doc.findText();
        app.findTextPreferences = NothingEnum.NOTHING;
        if (hits.length) {
            var where2 = "?"; try { where2 = hits[0].parentTextFrames[0].parentPage.name; } catch (e) {}
            log("[Printed in China] found (page " + where2 + ")");
            chinaFound.push(base);
        } else {
            log("[Printed in China] not found in this file");
        }

        // ---- Save fixed copy + export
        var tag = spec.role == "print" ? "_PRINT" : "_PREVIEW";
        doc.save(new File(outFolder.fsName + "/" + base + "_FIXED.indd"));
        setPdfPrefs(spec.role);
        var pdf = new File(outFolder.fsName + "/" + base + tag + ".pdf");
        doc.exportFile(ExportFormat.PDF_TYPE, pdf, false);
        log("[Export] " + pdf.name + " (" + pc + " pages)");
        doc.close(SaveOptions.NO);

        return spec.label + ": " + (attention ? attention + " item(s) need attention" : "OK");
    }

    function uniq(a) {
        var o = {}, r = [];
        for (var i = 0; i < a.length; i++) if (!o[a[i]]) { o[a[i]] = 1; r.push(a[i]); }
        return r;
    }

    function setPdfPrefs(role) {
        var p = app.pdfExportPreferences;
        function set(k, v) { try { p[k] = v; } catch (e) { log("  note: could not set PDF option " + k); } }
        var print = role == "print";
        set("standardsCompliance", print ? PDFXStandards.PDFX1A2001_STANDARD : PDFXStandards.NONE);
        set("acrobatCompatibility", print ? AcrobatCompatibility.ACROBAT_4 : AcrobatCompatibility.ACROBAT_7);
        set("pageRange", PageRange.ALL_PAGES);
        set("exportReaderSpreads", false);
        set("pdfColorSpace", PDFColorSpace.REPURPOSE_CMYK);
        set("pdfDestinationProfile", PDFProfileSelector.USE_DOCUMENT);
        var dpi = print ? 300 : 150, thr = print ? 450 : 225;
        set("colorBitmapSampling", Sampling.BICUBIC_DOWNSAMPLE);
        set("colorBitmapSamplingDPI", dpi);
        set("thresholdToCompressColor", thr);
        set("colorBitmapCompression", BitmapCompression.AUTO_COMPRESSION);
        set("colorBitmapQuality", print ? CompressionQuality.MAXIMUM : CompressionQuality.HIGH);
        set("grayscaleBitmapSampling", Sampling.BICUBIC_DOWNSAMPLE);
        set("grayscaleBitmapSamplingDPI", dpi);
        set("thresholdToCompressGray", thr);
        set("grayscaleBitmapCompression", BitmapCompression.AUTO_COMPRESSION);
        set("grayscaleBitmapQuality", print ? CompressionQuality.MAXIMUM : CompressionQuality.HIGH);
        set("monochromeBitmapSampling", Sampling.BICUBIC_DOWNSAMPLE);
        set("monochromeBitmapSamplingDPI", 1200);
        set("thresholdToCompressMonochrome", 1800);
        set("cropImagesToFrames", true);
        set("compressTextAndLineArt", true);
        set("cropMarks", false);
        set("bleedMarks", false);
        set("registrationMarks", false);
        set("colorBars", false);
        set("pageInformationMarks", false);
        set("useDocumentBleedWithPDF", print);
        if (!print) { set("bleedTop", 0); set("bleedBottom", 0); set("bleedInside", 0); set("bleedOutside", 0); }
        set("includeSlugWithPDF", false);
        set("subsetFontsBelow", 100);
        set("includeBookmarks", false);
        set("includeHyperlinks", false);
        set("exportLayers", false);
        set("generateThumbnails", false);
        set("optimizePDF", !print);
        set("viewPDF", false);
    }
})();
